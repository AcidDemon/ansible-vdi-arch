# dunst 1.13 -- Catppuccin Mocha, modelled on Cozytile (espeak hook and
# [shortcuts] dropped; bind `dunstctl close|close-all|history-pop` in qtile).
# Reload after edits: dunstctl reload

[global]
    monitor = 0
    follow = mouse

    # Top-right, clear of the qtile bar: 15px bar margin + 30px bar + 10px gap.
    width = (300, 400)
    height = (0, 300)
    origin = top-right
    offset = (12, 50)   # qtile bar: 8px margin + 32px + 10px gap
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    transparency = 0
    # gap_size > 0: every notification is its own rounded card (separator unused).
    gap_size = 6
    separator_height = 2
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 12
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = "WhiteSur, Adwaita"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 6

    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#b4befe"
    highlight = "#b4befe"
    timeout = 2
    default_icon = dialog-information

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    highlight = "#89b4fa"
    timeout = 4
    default_icon = dialog-information

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0
    default_icon = dialog-warning
